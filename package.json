{
  "name": "openhermes-opencode",
  "version": "1.0.8",
  "description": "OpenHermes plugin suite for OpenCode — autonomous checkpointing, memory recall, skill-candidate detection, built-in dynamic-context-pruning, and runtime curation.",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./autorecall": "./autorecall.mjs",
    "./curator": "./curator.mjs",
    "./skill-builder": "./skill-builder.mjs",
    "./ohc-pruner": "./ohc-pruner.mjs"
  },
  "files": [
    "index.mjs",
    "autorecall.mjs",
    "curator.mjs",
    "skill-builder.mjs",
    "bootstrap.mjs",
    "ohc-pruner.mjs",
    "ohc-pruner-core.mjs",
    "lib/",
    "schemas/",
    "harness/",
    "dist/ohc-pruner-core.js",
    "dist/ohc-pruner/**/*.js"
  ],
  "scripts": {
    "build:ohc": "npx tsc -p tsconfig.json",
    "build:ohc:watch": "npx tsc -p tsconfig.json --watch",
    "prebuild:ohc": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\""
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "openhermes",
    "checkpoint",
    "curation",
    "memory",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathwn12/opencode-openhermes.git"
  },
  "bugs": {
    "url": "https://github.com/nathwn12/opencode-openhermes/issues"
  },
  "homepage": "https://github.com/nathwn12/opencode-openhermes#readme",
  "author": "nathwn12",
  "dependencies": {
    "version": "^0.0.1"
  }
}
