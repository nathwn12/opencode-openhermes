{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OHC Configuration",
  "description": "OpenHermes Context pruner configuration — controls automatic conversation compression with absolute boundaries",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Master switch — false disables all auto-pruning"
    },
    "preset": {
      "type": "string",
      "enum": ["soft", "default", "hard"],
      "default": "default",
      "description": "Aggression preset: soft=relaxed (max=200K), default=balanced (max=100K), hard=aggressive (max=80K)"
    },
    "max": {
      "type": "integer",
      "minimum": 10000,
      "default": 100000,
      "description": "Hard ceiling — AI MUST compress when tokens exceed this. Overrides preset when set."
    },
    "min": {
      "type": "integer",
      "minimum": 10000,
      "default": 50000,
      "description": "Target floor after compression. Overrides preset when set."
    },
    "notification": {
      "type": "string",
      "enum": ["chat", "toast", "off"],
      "default": "chat",
      "description": "Notification delivery method"
    },
    "notificationMode": {
      "type": "string",
      "enum": ["detailed", "minimal"],
      "default": "detailed",
      "description": "Notification verbosity"
    }
  },
  "additionalProperties": false
}
